DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,recru.milanpars.com
# با دامنهٔ واقعی و HTTPS، Django فرم‌های POST از مبدأ دیگر را بدون این فهرست رد می‌کند.
DJANGO_CSRF_TRUSTED_ORIGINS=https://recru.milanpars.com

POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=recruitment
POSTGRES_HOST=db
POSTGRES_PORT=5432

# research.md §4 — پیاده‌سازی تولید در فاز استقرار جایگزین می‌شود
SCANNER_BACKEND=apps.attachments.scanning.clamd_client.ClamdScannerClient
CLAMD_HOST=clamav
CLAMD_PORT=3310
